{
  "name": "rust-wps-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-pdf.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "test:ui": "playwright test",
    "test:pagination": "playwright test --config tests/ui/word-paragraph-pagination.config.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "pdfjs-dist": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tauri-apps/cli": "2.11.5",
    "typescript": "^5",
    "vite": "^7"
  }
}

+          </w:style>"#);
+        assert_eq!(sheet.default_paragraph_style_id.as_deref(), Some("BodyInAnyLanguage"));
+        assert_eq!(sheet.effective_run_properties(None, None).font_size, Some(HalfPoint(28)));

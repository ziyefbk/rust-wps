+/// Page breaks inside table cells or list items need a richer layout path.
+/// The read-only IR degrades them to line breaks, with an explicit warning
+/// that consumers can use to refuse an editable conversion.
+fn nested_manual_page_break(p: &DocParagraph) -> bool {
+    p.text.contains('\x0C')
+        && (p.props.f_in_table
+            || p.props.is_table_trailing_mark
+            || (p.props.outline_level.is_none() && is_doc_list_item(p.props.ilfo)))
+}
+
+fn warn_nested_manual_page_breaks(paragraphs: &[DocParagraph], warnings: &mut Vec<String>) {
+    let count: usize = paragraphs
+        .iter()
+        .filter(|p| nested_manual_page_break(p))
+        .map(|p| p.text.matches('\x0C').count())
+        .sum();
+    if count > 0 {
+        warnings.push(format!(
+            "DOC_MANUAL_PAGE_BREAK_IN_TABLE_OR_LIST: {count} manual page break(s) inside table cells or list items are shown as line breaks; editable import must be blocked"
+        ));
+    }
+}

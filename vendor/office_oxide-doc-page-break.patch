+/// Structured paragraph text keeps manual 0x0C marks; section marks have
+/// already been removed as paragraph terminators by `build_paragraphs`.
+/// Split only at those manual marks, preserving every other byte and the
+/// original byte-coordinate system for hyperlinks and character properties.
+fn emit_manual_page_break_paragraph(
+    p: &DocParagraph,
+    has_structured_headings: bool,
+    elements: &mut Vec<Element>,
+) {
+    let heading_level = p
+        .props
+        .outline_level
+        .map(|level| level.saturating_add(1).clamp(1, 6))
+        .or_else(|| {
+            (!has_structured_headings)
+                .then(|| guessed_heading_level(p.text.trim(), elements))
+                .flatten()
+        });
+    let mut base = 0;
+    for (index, segment) in p.text.split('\x0C').enumerate() {
+        if index > 0 {
+            elements.push(Element::PageBreak);
+        }
+        // Empty boundary pieces do not add blank paragraphs around a break.
+        // Whitespace-only pieces are real content and must remain intact.
+        if !segment.is_empty() {
+            let content = inline_content_at(segment, base, &p.hyperlinks, &p.chp_runs);
+            if let Some(level) = heading_level {
+                elements.push(Element::Heading(Heading {
+                    level,
+                    content,
+                    ..Default::default()
+                }));
+            } else {
+                elements.push(Element::Paragraph(Paragraph {
+                    content,
+                    tabs: p.props.tabs.clone(),
+                    alignment: p.props.alignment.clone(),
+                    indent_left_twips: p.props.indent_left_twips,
+                    indent_right_twips: p.props.indent_right_twips,
+                    first_line_indent_twips: p.props.first_line_indent_twips,
+                    space_before_twips: p.props.space_before_twips,
+                    space_after_twips: p.props.space_after_twips,
+                    line_spacing: p.props.line_spacing.clone(),
+                    ..Default::default()
+                }));
+            }
